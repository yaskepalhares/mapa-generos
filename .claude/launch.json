{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mapa-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "web",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "mapa-web-livre",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-8781}\" --directory web --bind 127.0.0.1"
      ],
      "port": 8781
    }
  ]
}
